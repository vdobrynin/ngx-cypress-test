{
  "name": "ngx-cypress-test",
  "version": "5.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vdobrynin/ngx-cypress-test.git"
  },
  "bugs": {
    "url": "https://github.com/vdobrynin/ngx-cypress-test/issues"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "test": "ng test",
    "cy:verify": "cypress verify",
    "cy:run": "cypress run --headless",
    "cy:run_spec": "cypress run --spec 'cypress/integration/testWithPageObjects.spec.js' --headless",
    "cy:run_visual": "cypress run --spec 'cypress/integration/visualTest.spec.js' -b chrome",
    "cy:run_cypress:e2e": "start-server-and-test start http-get://localhost:4200 cy:run"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "21.0.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fortawesome/fontawesome-free": "^5.2.0",
    "@nebular/auth": "17.0.0",
    "@nebular/eva-icons": "17.0.0",
    "@nebular/security": "17.0.0",
    "@nebular/theme": "17.0.0",
    "@yoch/ng-smart-table": "^2.1.0",
    "bootstrap": "4.3.1",
    "eva-icons": "^1.1.0",
    "ionicons": "2.0.1",
    "nebular-icons": "1.1.0",
    "pace-js": "1.0.2",
    "roboto-fontface": "0.8.0",
    "rxjs": "~7.8.2",
    "socicon": "3.0.5",
    "tinymce": "4.5.7",
    "tslib": "^2.8.1",
    "typeface-exo": "0.0.22",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.0",
    "@cypress/snapshot": "^2.1.7",
    "@percy/cli": "^1.28.7",
    "@percy/cypress": "^3.1.9",
    "@types/node": "^24.10.0",
    "cypress": "^16.3.0",
    "cypress-parallel": "^0.15.0",
    "cypress-split": "^1.24.17",
    "husky": "^8.0.3",
    "jsdom": "^28.0.0",
    "playwright-webkit": "^1.52.0",
    "prettier": "^3.5.3",
