# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files

# =========================
# Dependencies and logs
# =========================
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
.npm/
.node_repl_history
*.tgz

# =========================
# Angular and build output
# =========================
/dist/
/tmp/
/out-tsc/
/bazel-out/
/.angular/
/.history/
/coverage/
/docs/
/typings/
/.sass-cache/
/connect.lock
/libpeerconnection.log
testem.log
*.tsbuildinfo
.eslintcache
.stylelintcache

# Native node-gyp output
/build/*

# =========================
# Environment variables
# =========================
.env
.env.*
!.env.example
cypress.env.json

# =========================
# Cypress and test output
# =========================
/cypress/videos/
/cypress/screenshots/
/cypress/downloads/
/cypress/results/
/cypress/reports/
__screenshots__/

# Keep visual regression baselines tracked:
# cypress/integration/__image_snapshots__/
# cypress/integration/__snapshots__/

# =========================
# IDE and editors
# =========================
/.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# VSCode: keep shared project settings
/.vscode/*
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/extensions.json
!/.vscode/mcp.json

# =========================
# End-to-end test output
# =========================
/e2e/*.js
/e2e/*.map

# =========================
# OS files
# =========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
